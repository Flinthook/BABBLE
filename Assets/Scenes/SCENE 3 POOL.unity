  CurrentIDCounter: 40
  json: "{\"Options\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":2}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":98.66678,\"yPos\":320.9998},\"ID\":1,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFPropiedad?\",\"parentUIDs\":[0],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":104.333435,\"yPos\":545.6666},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFPero
    t\xFA quien eres?\",\"parentUIDs\":[2],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":16.99997,\"yPos\":742.9999},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Juda.\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":7}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":252.3335,\"yPos\":740.9999},\"ID\":6,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Soy
    la noche. Soy la sombra. El golpe del martillo. El azote de la justicia.\",\"parentUIDs\":[4],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":4.333252,\"yPos\":1025.66614},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
    estoy aqu\xED para comprar.\",\"parentUIDs\":[7],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":283.000183,\"yPos\":1008.33289},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pero
    si est\xE1 lloviendo amianto. esto es inhabitable.\",\"parentUIDs\":[7],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-97.666626,\"yPos\":1253.00024},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Estoy
    pelau.\",\"parentUIDs\":[10],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":115,\"yPos\":1255.00024},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
    tengo un duro...\",\"parentUIDs\":[10],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":16}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1.666626,\"yPos\":1480.33374},\"ID\":15,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Esto
    suena a estafa. \xBFT\xFC no trabajas?\",\"parentUIDs\":[14],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-128.333237,\"yPos\":1673.6665},\"ID\":17,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pero
    tu tienes un morro impresionante.\",\"parentUIDs\":[16],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":112.333435,\"yPos\":1673.6665},\"ID\":18,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Antes
    he hablado con Jakub.\",\"parentUIDs\":[16],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":353.666382,\"yPos\":1247.00024},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Tampoco
    es que tenga dinero para comprar nada.\",\"parentUIDs\":[11],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":25}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":114.333435,\"yPos\":1841.00024},\"ID\":23,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
    es broma. El tipo con el radio... \xBFradiojakubette? A\xFAn no me he enterado
    de la nomenclatura.\",\"parentUIDs\":[22,26],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":26}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":340.333374,\"yPos\":1713},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ha
    vuelto.\",\"parentUIDs\":[22],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":28}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":338.333252,\"yPos\":1927.66675},\"ID\":27,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Te
    digo con total seguridad de que ese hombre es Jakub. \xBFNo has visto la corona
    de espinas? Es altamente aleg\xF3rico.\",\"parentUIDs\":[25],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":96.3334656,\"yPos\":2120.33325},\"ID\":29,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Voy
    a derribar la Torre.\",\"parentUIDs\":[21,28],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":33}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":97.00015,\"yPos\":2296.99854},\"ID\":31,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
    es broma. Voy a destruirlo todo.\",\"parentUIDs\":[30],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":38}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":353.999756,\"yPos\":2275.66455},\"ID\":34,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Me
    dan igual.\",\"parentUIDs\":[33,36],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":36}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":576.666565,\"yPos\":2154.99878},\"ID\":35,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Bueno...\",\"parentUIDs\":[33],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":355.999817,\"yPos\":2472.998},\"ID\":39,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
    te debo explicaciones. Aparta o cae con la Torre.\",\"parentUIDs\":[38],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":111,\"yPos\":188.000031},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFLe
    has echado el ojo a alguna propiedad?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"???\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.588},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":3}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":95.00006,\"yPos\":426.666046},\"ID\":2,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Claro.
    Para eso estamos aqu\xED, para buscar gente interesada en las nuevas viviendas
    reacondicionadas.\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"???\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.607},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":5},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":105.666748,\"yPos\":606.6666},\"ID\":4,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Sertet
    Nasir, t\xE1taratataranieta del vendedor de cobre m\xE1s famoso de todos los
    tiempos. Y emprendedora, comercial, amante de la vida, etc\xE9tera, etc\xE9tera.
    \xBFY usted?\",\"parentUIDs\":[3],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.603},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":133.000061,\"yPos\":873.999146},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ya
    veo... \xBFy qu\xE9 vivienda ha llamado tu atenci\xF3n?\",\"parentUIDs\":[5,6],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.588},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":13}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-10.333374,\"yPos\":1131.333},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Qu\xE9
    tonter\xEDa! Todos estamos aqui para comprar. \xA1Constantemente!\",\"parentUIDs\":[8],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.544},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":19}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":359.66626,\"yPos\":1101.3335},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Bah!
    Eso es una mera teor\xEDa. Consultamos con un t\xE9cnico y nos dijo que era hipot\xE9ticamente
    algo seguro quiz\xE1s. \",\"parentUIDs\":[9],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.51},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-5,\"yPos\":1364},\"ID\":14,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Sin
    problema! Tambi\xE9n necesitamos trabajadores para reconstruir los edificios.
    Si quieres podemos ir a firmar un contrato... y en unos... 129 a\xF1os tendr\xE1s
    tu casa pagada.\",\"parentUIDs\":[12,13,19],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.516},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-13.666626,\"yPos\":1553.3335},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFYo?
    \xA1Por Jakub, no! Va en contra de mi religi\xF3n. Ver\xE1s, todos los Proto-Jakubianos
    estamos esperando a la vuelta del salvador para ayudar en la torre... hasta entonces
    es nuestro deber... bueno, disfrutar de los placeres que ofrece.\",\"parentUIDs\":[15],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.594},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":29}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-128.333237,\"yPos\":2024.667},\"ID\":21,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Oye!
    \xA1Vaya falta de respeto! Qu\xE9 est\xE1s haciendo aqu\xED, si es que de verdad
    no quieres comprar una casa...\",\"parentUIDs\":[17],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.575},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":24}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":116.333435,\"yPos\":1740.66675},\"ID\":22,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ja
    ja ja. No me r\xEDo, no juegues con la f\xE9, no es cuesti\xF3n de gracias.\",\"parentUIDs\":[18],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.623},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":27}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":111.000122,\"yPos\":1929.3335},\"ID\":25,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ah,
    claro. Te refieres al tarado ese... No, no. Es un farsante.\",\"parentUIDs\":[23],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.583},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":334.333374,\"yPos\":1803.3335},\"ID\":26,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFPero
    de qu\xE9 hablas?\",\"parentUIDs\":[24],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.571},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":29}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":335.666626,\"yPos\":2024.667},\"ID\":28,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Ya
    basta! \xBFQu\xE9 haces aqu\xED, aparte de insultarme?\",\"parentUIDs\":[27],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.597},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":31}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":96.33353,\"yPos\":2193.999},\"ID\":30,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Ya
    vale con las bromitas!\",\"parentUIDs\":[29],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.568},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":34},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":35}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":355.6665,\"yPos\":2156.66577},\"ID\":33,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFPero
    qu\xE9 dices? \xBFY la gente que vivimos en la torre? \xBFY los centenares de
    familias que podr\xEDan vivir una vida saludablemente cuestionable en estos preciosos
    pisos reacondicionados?\",\"parentUIDs\":[31],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.642},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":34}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":799.3337,\"yPos\":2149.99927},\"ID\":36,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xD1EEEC
    error. Son las 5 de la ma\xF1ana y no tengo tiempo para escribir otras cosas.
    Vamos a destruir la torre. Chachi piruli.\",\"parentUIDs\":[35],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.631},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":39}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":351.999817,\"yPos\":2349.33154},\"ID\":38,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFPor
    qu\xE9 harias esto?\",\"parentUIDs\":[34],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Sertet
    Nasir\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.594}]}"
