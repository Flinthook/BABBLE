    no suena muy lucrativo.\",\"parentUIDs\":[24],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":28}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-525.3334,\"yPos\":-655.6665},\"ID\":27,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFVapers?\",\"parentUIDs\":[25],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":31}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-650.666748,\"yPos\":-464.333282},\"ID\":29,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Suena
    bastante m\xE1s divertido que el tabaco.\",\"parentUIDs\":[28],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":32}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-382.666138,\"yPos\":-465.000031},\"ID\":30,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Me
    encanta fumar tabaco.\",\"parentUIDs\":[28],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":34}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-641.333252,\"yPos\":-258.332733},\"ID\":33,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Suena
    horrible.\",\"parentUIDs\":[31,32],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":34}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-409.9994,\"yPos\":-258.332733},\"ID\":35,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Suena
    incre\xEDble.\",\"parentUIDs\":[31,32],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":37}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-517.3334,\"yPos\":-69.00369},\"ID\":36,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFPuedo
    probarlo?\",\"parentUIDs\":[34],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":39}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-518,\"yPos\":108.331848},\"ID\":38,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFEurod\xF3lares?\",\"parentUIDs\":[37],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":45}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-251.999344,\"yPos\":-57.0036926},\"ID\":40,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFDoblones?\",\"parentUIDs\":[39],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":43}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-17.33487,\"yPos\":-175.669662},\"ID\":41,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFElectrolitos
    para caballos?\",\"parentUIDs\":[39],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":44}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-22.0016174,\"yPos\":-91.0032043},\"ID\":42,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFPIEL?\",\"parentUIDs\":[39],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":48}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":214.665054,\"yPos\":144.330811},\"ID\":46,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Yo...
    no tengo nada de eso.\",\"parentUIDs\":[43,44,45],\"SpeechUID\":-1},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":50}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":213.332047,\"yPos\":358.330475},\"ID\":49,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFS\xF9per
    Aledi?\",\"parentUIDs\":[48],\"SpeechUID\":-1},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":216.665176,\"yPos\":538.998047},\"ID\":51,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...\",\"parentUIDs\":[50],\"SpeechUID\":-1}],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":1}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":-1087.66577,\"yPos\":-1959.99963},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Hey!
    Hola... \xA1Hola!\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"???\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.585},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":4}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1101.33289,\"yPos\":-1703.99988},\"ID\":3,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFNo
    estar\xE1s falto de... cualquier cosa?\",\"parentUIDs\":[1],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"???\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.603},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":6}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-1094.33228,\"yPos\":-1469.33337},\"ID\":5,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1M\xE1s
    o menos! Hace un par de semanas tuve que dejar de vender amianto... me lo compraron
    todo...\",\"parentUIDs\":[4],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"???\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.659},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":8},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-830.6671,\"yPos\":-1868.00037},\"ID\":7,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"El
    mism\xEDsimo S\xF9per Aledi. O bueno... uno de sus avatares. Hace tiempo que
    perd\xED la cuenta...\",\"parentUIDs\":[6],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.562},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":15}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-629.999939,\"yPos\":-1586.66565},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Claro,
    ya sabes, la representaci\xF3n de una deidad en el plano terrenal, como Fernando
    Alonso o el tabaco.\",\"parentUIDs\":[8,14],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.596},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-336.66626,\"yPos\":-1977.99915},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No,
    no. S\xF9per Aledi. No S\xFAper Aledi. \",\"parentUIDs\":[9],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.615},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":14}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-389.9995,\"yPos\":-1778.00037},\"ID\":13,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pues
    eso, como te dec\xEDa, soy un avatar de S\xF9per Aledi. \",\"parentUIDs\":[12],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.588},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":17},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":18}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-633.9998,\"yPos\":-1423.33362},\"ID\":16,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Jajaja.
    No te preocupes. \\n\xBFVas a querer algo o no?\",\"parentUIDs\":[15],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.588},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":21}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-464.666138,\"yPos\":-1258.00061},\"ID\":19,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Venga,
    enrollate... d\xE9jame ense\xF1arte lo que tengo al menos... si no cumplo una
    tasa semanal de clientes me FULMINAN.\",\"parentUIDs\":[18],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.574},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":22},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":23}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-561.999939,\"yPos\":-1080.6676},\"ID\":20,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Pues
    mira, llevo encima cl\xE1sicos como setecientos kilogramos de cebada, unos quince
    tipos de especias y varias piedras,\",\"parentUIDs\":[17,21],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.6},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":26}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-397.3329,\"yPos\":-919.33374},\"ID\":24,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Varias.\",\"parentUIDs\":[23],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.559},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":27}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-530.667,\"yPos\":-763.3329},\"ID\":25,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Eso...
    eso pienso yo... es lo que me est\xE1n haciendo vender. Eso y bueno... los \\\"vapers\\\"\",\"parentUIDs\":[22,26],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.536},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":29},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":30}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-531.3336,\"yPos\":-568},\"ID\":28,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Si.
    Son como unos cacharritos que te fumas. Como el tabaco, pero menos guay... \xBFpero
    m\xE1s guay? \\nNo estoy seguro de como se equilibra que sea un juguetito electr\xF3nico
    con lo que mola fumarse un cigarrito.\",\"parentUIDs\":[27],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.618},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":33},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":35}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-650.0001,\"yPos\":-397.333862},\"ID\":31,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
    se si estoy de acuerdo. Lo que desde luego es cierto es que es mortalmente adictivo.
    Lo prob\xE9 por curiosidad y ahora no puedo parar. Y como no est\xE1 prohibido
    \\\"vapear\\\" dentro de la torre, puedo hacer SIN PARAR.\",\"parentUIDs\":[29],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.615},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":33},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":35}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-386.666138,\"yPos\":-396.000366},\"ID\":32,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Muy
    bien dicho. Aunque lo bueno de \\\"vapear\\\" es que puedes hacerlo en cualquier
    lado,  a diferencia del tabaco, no est\xE1 prohibido dentro de la torre.\",\"parentUIDs\":[30],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.581},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":36}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-511.333069,\"yPos\":-170.00267},\"ID\":34,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Lo
    es! A los ni\xF1os les ENCANTA vapear. Las ventas se han disparado, ya nadie
    quiere cebada o piedras, solo piensan en vapear.\",\"parentUIDs\":[33,35],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.574},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":38}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-516.666565,\"yPos\":-0.6682129},\"ID\":37,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Claro!
    Son unos quince eurod\xF3lares.\",\"parentUIDs\":[36],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.603},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":40},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":41},{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":42}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-250.666092,\"yPos\":-173.336166},\"ID\":39,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Si!
    Tambi\xE9n aceptamos rublos, pesos, pesetas, piel, doblones, electrolitos de
    caballo y la misteriosa roca \xE1mbar que crece bajo la torre.\",\"parentUIDs\":[38],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.629},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":46}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":413.3327,\"yPos\":-176.00267},\"ID\":43,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Si!
    Es mi segunda cosa favorita despu\xE9s de vapear.\",\"parentUIDs\":[41],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.641},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":46}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":217.331924,\"yPos\":-81.3367},\"ID\":44,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Si...
    es para la Gran Efigie de Piel del piso catorce.\",\"parentUIDs\":[42],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.652},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":46}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":-20.6678772,\"yPos\":-13.3361816},\"ID\":45,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xA1Arrr!
    Jajaja.\",\"parentUIDs\":[40],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.611},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":49}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":214.665054,\"yPos\":242.664215},\"ID\":48,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"...\",\"parentUIDs\":[46],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.674},{\"Connections\":[{\"__type\":\"EditableOptionConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":51}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":212.665054,\"yPos\":426.663055},\"ID\":50,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Fuera
    de aqu\xED.\",\"parentUIDs\":[49],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"S\xF9per
    Aledi\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.637}]}"
